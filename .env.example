# Kaggle credentials (do NOT commit real values / kaggle.json)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Dataset
# Official CarDD dataset — verified to ship real COCO polygon segmentation
# masks (not bounding-box-only) with a pre-made train/val/test split.
DATASET_SLUG=issamjebnouni/cardd
DATASET_RAW_DIR=data/raw
DATASET_PROCESSED_DIR=data/processed

# Model / inference
MODEL_WEIGHTS_PATH=models/best.pt
FALLBACK_WEIGHTS_PATH=yolov8s-seg.pt
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
DEVICE=cpu

# API
MAX_UPLOAD_SIZE_MB=10
ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp
