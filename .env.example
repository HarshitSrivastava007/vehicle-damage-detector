# Model / inference
MODEL_WEIGHTS_PATH=models/best.pt
FALLBACK_WEIGHTS_PATH=yolov8s-seg.pt
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
DEVICE=cpu

# API
MAX_UPLOAD_SIZE_MB=10
ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp

# Database
# SQLite by default (zero extra infra). Swap to Postgres via
# postgresql+psycopg2://user:pass@host/db (pip install psycopg2-binary) —
# no code change needed, only the driver install + this URL.
DATABASE_URL=sqlite:///./app.db

# Session cookies
# "production" makes the login session cookie Secure (HTTPS only) — leave
# as "development" for local HTTP testing, or logins will silently not
# stick (browser refuses to store a Secure cookie over plain HTTP).
ENVIRONMENT=development
